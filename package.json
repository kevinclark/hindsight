{
  "name": "hindsight",
  "private": true,
  "version": "0.1.0",
  "description": "Lint FRC robot match logs in the browser. Team 8033.",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html hindsight.html",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "extract-fixtures": "node --experimental-strip-types scripts/extract-fixtures.ts",
    "bench": "node --experimental-strip-types scripts/bench.ts",
    "golden": "node --max-old-space-size=16000 --experimental-strip-types scripts/golden.ts",
    "build:app": "vite build && vite build -c vite.electron.config.ts",
    "app": "npm run build:app && electron .",
    "dist:app": "npm run build:app && electron-builder"
  },
  "dependencies": {
    "ssh2": "1.17.0",
    "tree-sitter-java-orchard": "0.5.22",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@msgpack/msgpack": "3.1.2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.19.2",
    "@types/ssh2": "1.15.6",
    "@types/ws": "8.18.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3",
    "ws": "8.21.3"
  },
  "allowScripts": {
    "tree-sitter-java-orchard": false,
    "electron": true
  },
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "io.github.kevinclark.hindsight",
    "productName": "Hindsight",
    "copyright": "BSD-3-Clause",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/index.html",
      "dist-electron/**",
      "package.json",
      "!node_modules/cpu-features/**",
      "!node_modules/nan/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "artifactName": "Hindsight-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false
  }
}
