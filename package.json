{
  "name": "hindsight",
  "private": true,
  "version": "0.1.0",
  "description": "Lint FRC robot match logs in the browser. Team 8033.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html hindsight.html",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "extract-fixtures": "node --experimental-strip-types scripts/extract-fixtures.ts",
    "bench": "node --experimental-strip-types scripts/bench.ts"
  },
  "devDependencies": {
    "@msgpack/msgpack": "3.1.2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3",
    "ws": "8.21.3"
  }
}
